@Tutorial(time: 20) {
    @Intro(title: "같은 클릭을 귀와 손으로 나눠 듣기") {
        Safe Dial의 AHAP은 WAV 오디오와 그 파형에서 만든 햅틱을 같은 player clock에 놓습니다. 변환기를
        다시 만드는 대신 완성 cue를 오디오만, 햅틱만, 둘 다로 재생하고 근접도 곡선 하나를 조율합니다.

        @Image(source: "05-feedback-tuning.png", alt: "AUDIO & HAPTIC TUNING 패널에서 출력과 근접도 곡선을 조절하는 화면")
    }

    @Section(title: "오디오와 햅틱을 분리해서 체험하기") {
        @ContentAndMedia {
            - **수정할 파일:** `FeedbackTuning.swift`
            - **읽을 파일:** `Sounds/dial-detent-01.ahap`, `AudioHapticsPlayer.swift`
            - **확인할 결과:** cue의 시간 모양은 같고 출력 채널과 전체 세기만 달라짐

            라운드를 시작하기 전에 DEBUG 패널의 `AUDIO & HAPTIC TUNING`을 엽니다. 같은 손가락 동작을
            세 번 반복해야 채널 차이를 비교할 수 있습니다.

            @Image(source: "05-feedback-tuning.png", alt: "오디오와 햅틱 출력 토글 및 근접 곡선 슬라이더가 열린 DEBUG 패널")
        }

        @Steps {
            @Step {
                **Audio ON / Haptic OFF**로 다이얼을 돌려 녹음된 기계음의 타이밍을 듣습니다.
            }

            @Step {
                **Audio OFF / Haptic ON**으로 같은 속도와 방향을 반복해 손끝의 타격점을 느낍니다.
            }

            @Step {
                두 출력을 모두 켜고 같은 동작을 반복합니다. 소리와 촉감의 시작점이 별도 타이머처럼
                벌어지지 않고 한 사건으로 느껴지는지 확인합니다.
            }
        }
    }

    @Section(title: "한 AHAP 타임라인과 gain 역할 읽기") {
        @ContentAndMedia {
            **수정 전 문제 구조**는 오디오와 햅틱을 서로 다른 예약 경로에서 시작해 스케줄링 오차를
            만듭니다.

            현재 AHAP에는 `AudioCustom`, 연속 햅틱, 순간 햅틱이 같은 `Pattern`과 `Time`을 사용합니다.
        }

        @Steps {
            @Step {
                `dial-detent-01.ahap`에서 오디오와 두 연속 햅틱, 순간 햅틱이 하나의 `Pattern`과
                `Time`을 사용하는지 확인합니다.
                @Code(name: "dial-detent-01.ahap", file: "02-example-cue.ahap", reset: true)
            }

            @Step {
                엔진을 시작할 때 cue마다 advanced player를 한 번 만들고 `playerPool`에 저장하는 실제
                생성 경로를 확인합니다.
                @Code(name: "AudioHapticsPlayer.swift", file: "05-player-pool.swift", reset: true)
            }

            @Step {
                눈금 사건에서는 저장한 player를 재사용하고, 시작이 실패할 때만 풀을 한 번 복구해 같은
                cue를 재시도하는지 확인합니다.
                @Code(name: "AudioHapticsPlayer.swift", file: "03-play-reusable.swift", reset: true)
            }

            @Step {
                AHAP이 cue의 시간 모양을 소유하고 `FeedbackTuning.levels`가 현재 사건의 오디오·햅틱
                gain만 계산하는 경계를 확인합니다.
                @Code(name: "FeedbackTuning.swift", file: "05-gain-ownership.swift", reset: true) {
                    @Image(source: "05-feedback-tuning.png", alt: "런타임 오디오와 햅틱 gain을 조절하는 DEBUG 패널")
                }
            }
        }
    }

    @Section(title: "근접도 곡선을 바꾸고 비교하기") {
        @ContentAndMedia {
            지수가 1보다 작으면 중간 근접도부터 출력이 빨리 커지고, 1보다 크면 정답 가까이에서 급격히
            커집니다. 먼저 슬라이더로 미리 듣고, 마음에 든 값을 소스 기본값으로 옮깁니다.
        }

        @Steps {
            @Step {
                기본 `햅틱 근접 곡선` 0.60에서 목표와 먼 곳, 중간, 가까운 곳의 세기를 비교합니다.
                @Code(name: "FeedbackTuning.swift", file: "05-feedback-curve-before.swift", reset: true) {
                    @Image(source: "05-feedback-tuning.png", alt: "햅틱과 오디오 근접 곡선이 0.60인 기본 DEBUG 화면")
                }
            }

            @Step {
                DEBUG 슬라이더를 1.50으로 올리고 같은 경로를 다시 돌립니다. 중간 거리 클릭은 약해지고
                정답 가까이의 대비가 커지는지 확인합니다.
            }

            @Step {
                차이가 유효하면 `FeedbackTuning.swift`의 기본값도 1.50으로 바꿔 앱을 재실행합니다.
                @Code(name: "FeedbackTuning.swift", file: "05-feedback-curve-after.swift", previousFile: "05-feedback-curve-before.swift")
            }

            @Step {
                작은 과제로 오디오 곡선은 0.60에 두고 햅틱만 1.50으로 유지해봅니다. 두 채널이 서로 다른
                정보를 주는지, 어색하게 분리되는지 판단한 뒤 기본값 0.60으로 복원합니다.
                @Code(name: "FeedbackTuning.swift", file: "05-feedback-curve-restored.swift", previousFile: "05-feedback-curve-after.swift")
            }
        }
    }
}
