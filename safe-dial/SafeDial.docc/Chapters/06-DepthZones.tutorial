@Tutorial(time: 16) {
    @Intro(title: "연속 깊이를 세 안정 구간으로 나누기") {
        ARKit의 미터 값은 계속 변하지만 게임은 가까운·중간·먼 세 자물쇠 중 하나가 필요합니다.
        진입과 이탈 반경을 다르게 둔 히스테리시스로 경계 떨림을 제거합니다.
    }

    @Section(title: "중심과 두 반경 정하기") {
        @ContentAndMedia {
            표준 중심은 0cm, 10cm, 20cm입니다. 중심에서 3cm 안으로 들어와야 진입하고 4.5cm 밖으로
            나가야 이탈합니다. 두 구간의 이탈 영역이 겹치지 않게 설정을 검증합니다.

            <!-- IMAGE_REQUIRED: CH06-HYSTERESIS-BANDS -->
            > 이미지 자리: 세 중심과 enter/exit 반경을 겹쳐 그린 깊이 축
        }

        @Steps {
            @Step {
                중심, 진입 반경, 이탈 반경을 하나의 Configuration에 모으고 잘못된 조합은 즉시
                거부합니다.
                @Code(name: "DepthZoneResolver.swift", file: "06-zone-configuration.swift")
            }

            @Step {
                현재 zone이 있으면 이탈 판정을 먼저 합니다. 유지 범위 안에서는 다른 zone 탐색을
                시작하지 않아야 손떨림이 선택을 바꾸지 않습니다.
                @Code(name: "DepthZoneResolver.swift", file: "06-zone-update.swift")
            }
        }
    }

    @Section(title: "판정 깊이와 시각 깊이 분리하기") {
        @ContentAndMedia {
            zone 판정은 지연 없는 원값을 사용합니다. 화면의 링 위치와 크기에는 EMA로 평활한 깊이를
            사용합니다. 보기 좋은 값이 게임 규칙을 늦추지 않도록 두 스트림을 섞지 않습니다.
        }

        @Steps {
            @Step {
                프레임마다 raw `depth`는 그대로 저장하고 `visualDepth`만 평활합니다.
                @Code(name: "SpatialDepthStreams.swift", file: "06-depth-streams.swift")
            }

            @Step {
                perspective resolver는 세 중심과 visual depth를 받아 scale, blur, opacity, z-index를
                계산합니다. zone resolver는 이 화면 표현을 알지 못합니다.
            }
        }
    }

    @Section(title: "기기 없이 경계 검사하기") {
        @ContentAndMedia {
            `DepthZoneResolver`는 Foundation만 쓰는 순수 값 타입입니다. ARKit을 띄우지 않고 앞·뒤
            sweep, 경계 떨림, reset을 결정적으로 검사할 수 있습니다.

            <!-- IMAGE_REQUIRED: CH06-SPATIAL-STACK -->
            > 이미지 자리: 같은 화면에서 near/middle/far 링의 원근 차이
        }

        @Steps {
            @Step {
                enter 경계 안팎과 exit 경계 안팎의 표본을 순서대로 넣어 zone 전이가 정확한지 확인합니다.
                @Code(name: "DepthZoneResolverTests.swift", file: "06-zone-checks.swift")
            }

            @Step {
                중심이나 반경을 조정할 때는 순수 검사를 먼저 통과시킨 뒤 실기기에서 이동 감각을
                비교합니다. 자동 검사는 편안한 간격까지 승인하지 않습니다.
            }
        }
    }
}
