@Tutorial(time: 18) {
    @Intro(title: "맞는 공간 위치에서만 다이얼 열기") {
        다이얼은 항상 돌아가지 않습니다. tracking이 정상이고 현재 zone이 이번 자물쇠와 일치할 때만
        입력 클러치가 열립니다. 이 장에서는 공간 이동 중 터치가 다음 자물쇠에 섞이지 않는지 확인하고,
        정답을 확정하는 유지 시간 하나만 바꿉니다.

        @Image(source: "04-input-clutch.png", alt: "완충 구간에서 다이얼 입력이 동결된 DEBUG 화면")
    }

    @Section(title: "입력 활성과 동결 체험하기") {
        @ContentAndMedia {
            - **수정할 파일:** `DialGameModel.swift`
            - **읽을 파일:** `SpatialSafeDialModel.swift`, `SafeDialComponents.swift`,
              `CircularDialAccumulator.swift`
            - **확인할 결과:** zone 밖에서는 숫자가 멈추고, 재진입하면 다이얼이 0부터 다시 시작

            @Image(source: "04-input-clutch.png", alt: "깊이 완충 구간에서 다이얼 입력이 동결된 DEBUG 화면")
        }

        @Steps {
            @Step {
                첫 자물쇠를 시작해 다이얼을 몇 눈금 돌린 뒤 DEBUG 패널의 `터치 누적각`과 `현재 숫자`를
                기억합니다.
            }

            @Step {
                깊이 수동 주입을 켰다면 슬라이더를 5cm 완충 구간으로 옮깁니다. 실기기에서는 폰을 다음
                중심 사이로 움직입니다. `다이얼 입력`이 `동결`되는지 확인합니다.
            }

            @Step {
                동결 상태에서 다이얼을 계속 드래그해도 숫자가 바뀌지 않아야 합니다. 목표 zone으로
                돌아오면 누적각과 숫자가 0에서 새로 시작합니다.
            }
        }
    }

    @Section(title: "수정 전·후 입력 경계 읽기") {
        @ContentAndMedia {
            원형 제스처에서 `atan2` 절대각을 바로 쓰면 `-π`와 `+π` 경계를 지날 때 거의 한 바퀴가
            튑니다. 현재 구현은 매 샘플의 최단 델타만 누적합니다.
        }

        @Steps {
            @Step {
                `CircularDialAccumulator`가 첫 터치를 기준점으로만 쓰고, `-π...+π` 경계에서는 최단
                델타를 누적하는지 확인합니다.
                @Code(name: "CircularDialAccumulator.swift", file: "01-angle-accumulator.swift", reset: true)
            }

            @Step {
                실제 DragGesture가 절대각이 아니라 accumulator가 돌려준 `delta`만 게임 모델에
                전달하는지 확인합니다.
                @Code(name: "SafeDialComponents.swift", file: "04-dial-gesture.swift", reset: true)
            }

            @Step {
                `SpatialSafeDialModel.isAligned`가 tracking, 재보정, 현재 zone, 현재 차례를 한곳에서
                검사하는지 확인합니다.
                @Code(name: "SpatialSafeDialModel.swift", file: "07-alignment.swift", reset: true)
            }

            @Step {
                정렬 결과가 `game.setInputEnabled`로 넘어가고, 입력이 닫힐 때 속도·hold·마지막 눈금이
                함께 비워지는지 확인합니다.
                @Code(name: "DialGameModel.swift", file: "07-input-clutch.swift", reset: true) {
                    @Image(source: "04-input-clutch.png", alt: "입력 클러치가 닫혀 다이얼 입력이 동결된 화면")
                }
            }
        }
    }

    @Section(title: "맞물림 유지 시간을 바꾸기") {
        @ContentAndMedia {
            정답 눈금을 통과하는 사건과 자물쇠를 확정하는 사건은 다릅니다. 현재는 정답을 밟은 뒤
            허용 범위 안에서 0.3초 멈추면 맞물립니다. 시간 조건만 늘려 다른 판정은 그대로 둡니다.
        }

        @Steps {
            @Step {
                기본값으로 한 자물쇠를 열며 정답 클릭부터 확정음까지의 체감 시간을 기억합니다.
                @Code(name: "DialGameModel.swift", file: "04-hold-duration-before.swift", reset: true)
            }

            @Step {
                `DialGameModel.swift`의 `holdDuration`만 0.8로 바꾸고 같은 속도로 다시 접근합니다. 눈금
                클릭은 같지만 정답에서 더 오래 멈춰야 확정음이 나는지 확인합니다.
                @Code(name: "DialGameModel.swift", file: "04-hold-duration-after.swift", previousFile: "04-hold-duration-before.swift")
            }

            @Step {
                작은 과제로 0.15, 0.8 두 값을 번갈아 비교하고 자신에게 더 기계적으로 느껴지는 값을
                고릅니다. 다음 장으로 가기 전 기본값 0.3으로 복원합니다.
                @Code(name: "DialGameModel.swift", file: "04-hold-duration-restored.swift", previousFile: "04-hold-duration-after.swift")
            }
        }
    }
}
