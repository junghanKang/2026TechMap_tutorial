@Tutorial(time: 18) {
    @Intro(title: "도착 사건과 다이얼 입력 클러치 연결하기") {
        zone이 보인다는 사실과 피드백을 울릴 사건은 다릅니다. 유효한 미해결 zone에 새로 도착했을
        때만 단발 cue를 만들고, 현재 차례의 zone에서만 터치 다이얼을 활성화합니다.
    }

    @Section(title: "상태를 사건으로 바꾸기") {
        @ContentAndMedia {
            같은 zone에 머무는 동안은 반복하지 않습니다. 완충 구간까지 나갔다 다시 들어오면
            재무장합니다. tracking이 잠시 무효가 된 것만으로 같은 도착을 다시 만들지는 않습니다.

            <!-- IMAGE_REQUIRED: CH07-ARRIVAL-STATE-MACHINE -->
            > 이미지 자리: buffer → zone arrival → stay silent → buffer → reentry 흐름
        }

        @Steps {
            @Step {
                마지막 점유 zone을 기억하고 유효 context에서 zone이 달라질 때만 상태를 갱신합니다.
                @Code(name: "DepthArrivalFeedbackResolver.swift", file: "07-arrival-resolver.swift")
            }

            @Step {
                `zone.rawValue >= solvedCount` 조건으로 이미 푼 zone은 무음으로 만듭니다. 아직 차례가
                아니더라도 미해결 zone의 공간 도착감은 들려줄 수 있습니다.
            }
        }
    }

    @Section(title: "맞는 깊이에서만 다이얼 열기") {
        @ContentAndMedia {
            현재 풀 차례는 solved count에서 계산합니다. tracking이 정상이고 재보정이 필요 없으며
            현재 zone이 그 차례와 같을 때만 다이얼 입력을 엽니다.
        }

        @Steps {
            @Step {
                `expectedZone`, `isAligned`, `canStartRound`를 계산 속성으로 만듭니다. View가 조건을 다시
                조합하지 않게 합니다.
                @Code(name: "SpatialSafeDialModel.swift", file: "07-alignment.swift")
            }

            @Step {
                입력이 닫히면 속도, hold, 마지막 눈금 상태를 비웁니다. 다시 열릴 때 다이얼을 0에서
                시작해 깊이 이동 중의 터치가 다음 자물쇠에 섞이지 않게 합니다.
                @Code(name: "DialGameModel.swift", file: "07-input-clutch.swift")
            }
        }
    }

    @Section(title: "한 프레임의 처리 순서 고정하기") {
        @ContentAndMedia {
            raw depth가 검증된 뒤 zone을 갱신하고, 도착 사건을 만들고, 입력을 동기화하고, 마지막으로
            피드백을 재생합니다. 이 순서를 한 함수에 모으면 AR 프레임과 DEBUG 주입이 같은 경로를 탑니다.

            <!-- IMAGE_REQUIRED: CH07-FRAME-PIPELINE -->
            > 이미지 자리: reading → zone → arrival → clutch → feedback 파이프라인
        }

        @Steps {
            @Step {
                검증된 미터 값을 `processResolvedDepth` 하나로 보냅니다.
                @Code(name: "SpatialSafeDialModel.swift", file: "07-spatial-flow.swift")
            }

            @Step {
                도착 사건이 있을 때만 72ms single-hit cue를 재생합니다. 프레임별 이동 tick을 재생하지
                않으므로 이동 중 피드백 밀도가 센서 frame rate에 종속되지 않습니다.
            }
        }
    }
}
