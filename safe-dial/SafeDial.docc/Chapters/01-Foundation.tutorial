@Tutorial(time: 12) {
    @Intro(title: "터치 다이얼의 입력 경계 세우기") {
        이 장에서는 화면 전체를 만들지 않습니다. 손가락의 원형 이동을 연속 회전량으로 바꾸고,
        그 값이 게임 모델로 들어가는 경계만 준비합니다. 이후 오디오·햅틱과 깊이 입력은 이
        기준선을 바꾸지 않고 확장합니다.
    }

    @Section(title: "프로젝트와 실기기 조건 준비하기") {
        @ContentAndMedia {
            iOS SwiftUI 앱에서 시작합니다. ARKit 깊이와 Core Haptics는 시뮬레이터만으로 승인할 수
            없으므로 자동 검사와 실기기 확인을 처음부터 구분합니다. LiDAR는 필요하지 않습니다.
        }

        @Steps {
            @Step {
                SwiftUI App 프로젝트를 만들고 최소 배포 버전을 iOS 17 이상으로 둡니다. 카메라 사용
                설명을 추가하고 WAV와 AHAP이 앱 target의 resource로 복사되는지 확인합니다.
            }

            @Step {
                App 진입점은 루트 화면만 조립합니다. ARSession, haptic engine, 화면 꺼짐 같은 전역
                수명 정책을 여기에 섞지 않습니다.
                @Code(name: "SafeDialApp.swift", file: "01-app-root.swift")
            }

            @Step {
                시뮬레이터는 화면과 순수 로직 확인에, world tracking과 실제 촉감은 지원 iPhone에
                배정합니다. `ARWorldTrackingConfiguration.isSupported`와 Core Haptics capability를
                각각 확인할 준비를 합니다.
            }
        }
    }

    @Section(title: "입력 책임을 나누고 ±π 경계 풀기") {
        @ContentAndMedia {
            View는 손가락 위치를 읽고, 누적기는 각도 경계를 풀며, 게임 모델은 눈금과 정답을
            판정합니다. 센서나 피드백 코드를 View에 넣지 않으면 이후 두 하이라이트를 독립적으로
            검사할 수 있습니다.

            `atan2` 결과는 `-π...+π` 범위입니다. 손가락이 왼쪽 경계를 지나면 값이 거의 한 바퀴
            튀므로 차이를 같은 범위로 접은 뒤 누적해야 합니다.

            <!-- IMAGE_REQUIRED: CH01-RESPONSIBILITY-MAP -->
            > 이미지 자리: View → 각도 누적기 → 게임 모델의 세 책임 흐름
        }

        @Steps {
            @Step {
                터치 입력이 게임 규칙에 넘길 값은 절대각이 아니라 `deltaRadians` 하나로 정합니다.
                이 계약이면 손가락을 떼었다 다시 잡아도 게임 좌표가 점프하지 않습니다.
                @Code(name: "DialInputBoundary.swift", file: "01-input-boundary.swift")
            }

            @Step {
                이전 각도와 현재 각도의 차이를 구하고 `±2π`를 더하거나 빼서 최단 회전량으로 만듭니다.
                @Code(name: "CircularDialAccumulator.swift", file: "01-angle-accumulator.swift")
            }

            @Step {
                제스처 종료 때 `endGrip()`만 호출합니다. 누적 회전량은 게임 모델이 들고 있으므로
                누적기에는 마지막 손가락 각도를 남기지 않습니다.
            }
        }
    }

    @Section(title: "게임 입력에 연결하기") {
        @ContentAndMedia {
            원형 좌표를 100개 눈금으로 바꾸는 일과 피드백을 재생하는 일은 게임 모델의 책임입니다.
            View는 유효한 델타만 전달합니다.

            <!-- IMAGE_REQUIRED: CH01-ANGLE-SEAM -->
            > 이미지 자리: -π와 +π 경계를 가로지르는 손가락 경로
        }

        @Steps {
            @Step {
                드래그 위치에서 중심 기준 각도를 계산하고 누적기가 돌려준 델타를 적용합니다.
                @Code(name: "DialGesture.swift", file: "01-dial-gesture.swift")
            }

            @Step {
                빠른 왕복, 경계 통과, 재그립을 확인합니다. 이 기준선이 안정적이어야 뒤에서 들리는
                클릭 수가 실제 눈금 수와 일치합니다.
            }
        }
    }
}
