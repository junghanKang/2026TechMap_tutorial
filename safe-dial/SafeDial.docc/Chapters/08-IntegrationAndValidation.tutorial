@Tutorial(time: 20) {
    @Intro(title: "공간 다이얼을 통합하고 검증하기") {
        마지막 장에서는 tracking, zone, 도착 사건, 게임, 재생기의 수명 경계를 연결합니다. 자동 검사는
        순수 규칙과 리소스 회귀를 맡고, 실기기는 AR 복구와 실제 오디오·햅틱 감각을 승인합니다.
    }

    @Section(title: "라운드와 재보정 수명 묶기") {
        @ContentAndMedia {
            화면 진입은 tracking을 시작하고 라운드 시작은 현재 위치를 near 기준으로 잡습니다. 추적이
            끊기거나 프레임 깊이가 비정상적으로 튀면 입력을 닫고 사용자의 재보정을 기다립니다.

            <!-- IMAGE_REQUIRED: CH08-LIFECYCLE -->
            > 이미지 자리: screen appear, start round, recalibrate, disappear의 자원 수명
        }

        @Steps {
            @Step {
                첫 정상 프레임 이후 tracking이 무효가 되거나 프레임 점프가 신뢰 한계를 넘으면
                `needsRecalibration`을 세웁니다.
                @Code(name: "SpatialSafeDialModel.swift", file: "08-tracking-guard.swift")
            }

            @Step {
                재보정은 zone, 도착 점유, 시각 깊이와 frame jump 기준을 비우고 다음 프레임을 새 원점으로
                삼습니다. 이미 푼 게임 진행은 보존합니다.
                @Code(name: "SpatialSafeDialModel.swift", file: "08-recalibrate.swift")
            }

            @Step {
                화면이 사라질 때 ARSession, 게임, haptic engine, audio session을 명시적으로 정리합니다.
                앱 진입점은 화면 조립 외 전역 수명 정책을 갖지 않습니다.
            }
        }
    }

    @Section(title: "자동 검사를 층별로 실행하기") {
        @ContentAndMedia {
            한 종류의 검사로 모든 것을 증명하지 않습니다. 생성 리소스, gain 소유권, 깊이 순수 로직,
            게임 규칙, 앱 빌드를 각각 가장 작은 환경에서 확인합니다.
        }

        @Steps {
            @Step {
                스케치 루트에서 검증 명령을 순서대로 실행합니다.
                @Code(name: "validate.sh", file: "08-validation.sh")
            }

            @Step {
                DocC의 모든 tutorial reference와 code resource가 존재하는지 검사하고 documentation build를
                실행합니다. 경고와 오류는 본문·스냅샷 참조 문제로 취급합니다.
            }
        }
    }

    @Section(title: "실기기에서 계약 승인하기") {
        @ContentAndMedia {
            시뮬레이터는 Taptic Engine의 감각과 AR 월드 이동을 승인할 수 없습니다. 자동 검사 뒤 같은
            순서의 짧은 시나리오로 실제 기기만의 경계를 확인합니다.

            <!-- IMAGE_REQUIRED: CH08-FINAL-STATES -->
            > 이미지 자리: near/middle/far 각 정렬 상태와 완료 화면 비교
        }

        @Steps {
            @Step {
                near에서 시작해 middle, far 순으로 이동하며 각 도착은 한 번만 울리고 체류 중 반복하지
                않는지 확인합니다. 완충 구간을 거친 재진입은 다시 한 번 울려야 합니다.
            }

            @Step {
                오디오만, 햅틱만, 둘 다 켠 상태에서 detent의 근접도 곡선과 개방 cue 순서를 비교합니다.
                gain probe는 같은 cue를 써서 크기 차이만 듣고 느낍니다.
            }

            @Step {
                화면 잠금·복귀와 앱 이탈·재진입 뒤 입력이 임의로 열리지 않는지, 필요하면 재보정을
                요구하는지 확인합니다. 마지막으로 한 라운드를 완주합니다.
            }
        }
    }
}
