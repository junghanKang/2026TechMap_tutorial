@Tutorial(time: 25, projectFiles: "SafeDial-Tutorial.zip") {
    @XcodeRequirement(
        title: "Xcode 26.4 or later",
        destination: "https://developer.apple.com/download/"
    )

    @Intro(title: "사운드 재생 준비하기") {
        @Image(
            source: "tutorial-chapter-sound.png",
            alt: "눈금 통과, 목표 깊이 도달, 잠금 해제 이벤트를 나타내는 세 가지 사운드 파형"
        )

        다이얼 눈금을 넘길 때, 목표 깊이에 도달했을 때, 자물쇠가 열릴 때 각각 서로 다른 사운드가 출력됩니다.
        이 장에서는 조작 시점에 지연 없이 피드백이 나오도록 오디오 세션을 구성하고 고급 패턴 플레이어를 미리 준비합니다.

        이 장을 마치면 프로젝트에 정의된 오디오 큐(Cue)들을 햅틱 엔진에 사전 등록하고, 사용자 인터랙션 타이밍에 맞춰 즉각 재생할 수 있게 됩니다.

        먼저 완성 프로젝트를 빌드해 세 가지 피드백 사운드를 확인해 보세요. 관련 프레임워크가 낯설다면 Apple의
        [Core Haptics 가이드](https://developer.apple.com/documentation/corehaptics)와
        [AVAudioSession](https://developer.apple.com/documentation/avfaudio/avaudiosession) 문서를 함께 참고하면 도움이 됩니다.
        오디오 큐 식별자와 눈금 틱 교차 규칙은 스타터 프로젝트에 이미 구현되어 있으므로, 여기서는 엔진 초기화와 이벤트 연결 흐름에 집중합니다.
    }

    @Section(title: "초기화와 플레이어 캐싱 완료하기") {
        @ContentAndMedia {
            다이얼이 회전할 때마다 매번 사운드 파일을 읽고 플레이어를 새로 생성하면 조작 반응에 지연이 발생합니다.
            라운드를 시작할 때 오디오 세션 활성화, AHAP 패턴 파일 로드, 플레이어 인스턴스 준비를 한 번에 마쳐 둡니다.

            `CHHapticEngine(audioSession:)`을 사용하면 소리와 햅틱을 같은 시간 기준으로 함께 시작하도록 구성할 수 있습니다.

            준비 흐름은 왼쪽부터 '오디오 세션 설정 ➔ AHAP 패턴 로드 ➔ 햅틱 엔진 구동 ➔ 큐별 플레이어 캐싱' 순으로 이어집니다.
            초기 구동 시 이 네 단계를 완료해 두면, 이후 런타임에는 필요한 `cue`의 플레이어를 딕셔너리에서 즉시 꺼내 재사용할 수 있습니다.

            @Image(
                source: "tutorial-section-audio-preparation.png",
                alt: "오디오 세션 설정, AHAP 로드, 햅틱 엔진 시작을 거쳐 큐별 플레이어를 캐시에 등록하는 초기화 파이프라인"
            )
        }

        @Steps {
            @Step {
                앱의 오디오 세션을 구성하고, 사용자의 배경 음악과 사운드가 겹쳐서 자연스럽게 들릴 수 있도록 믹싱 옵션(`.mixWithOthers`)을 활성화합니다.
                엔진을 인스턴스화하기 전에 이 세션을 미리 활성화해 두어야 오디오가 정상적으로 출력됩니다.

                @Code(
                    name: "AudioHapticsPlayer.swift",
                    file: "01-02-01-AudioSession.swift",
                    previousFile: "01-02-00-Preparation-Scaffold.swift"
                )
            }

            @Step {
                정의된 모든 `cue`에 매핑되는 AHAP 파일을 번들에서 찾아 패턴(`CHHapticPattern`) 객체로 변환합니다.
                단 하나라도 로드에 실패하면 오류를 전달하고 불완전한 목록을 저장하지 않습니다.

                @Code(
                    name: "AudioHapticsPlayer.swift",
                    file: "01-02-02-LoadPatterns.swift",
                    previousFile: "01-02-01-AudioSession.swift"
                )
            }

            @Step {
                구성한 오디오 세션 참조를 주입하여 `CHHapticEngine`을 생성하고 동작을 시작합니다.
                이 단계에서는 엔진 런타임을 구동하는 데 집중하며, 개별 플레이어 생성은 다음 단계에서 이어집니다.

                @Code(
                    name: "AudioHapticsPlayer.swift",
                    file: "01-02-03-StartEngine.swift",
                    previousFile: "01-02-02-LoadPatterns.swift"
                )
            }

            @Step {
                엔진의 `makeAdvancedPlayer(with:)`를 사용해 각 패턴의 고급 플레이어(`CHHapticAdvancedPatternPlayer`)를 생성하고, `cue` 이름을 키로 캐시에 등록합니다.
                다이얼을 회전할 때 매번 플레이어를 생성하지 않고 캐시된 인스턴스를 재사용하며, 너무 빠른 입력은 최소 간격(16ms)으로 제한하여 안정적으로 재생합니다.

                @Code(
                    name: "AudioHapticsPlayer.swift",
                    file: "01-02-04-PreparePlayers.swift",
                    previousFile: "01-02-03-StartEngine.swift"
                )
            }
        }
    }

    @Section(title: "사운드 재생 라우팅 구현하기") {
        @ContentAndMedia {
            캐시에서 타깃 `cue`의 플레이어를 조회한 후, 볼륨과 햅틱 강도 값을 전달합니다.
            아직 햅틱 패턴 세부 데이터를 정의하기 전이라도, 재생 메서드 인터페이스는 두 매개변수를 모두 받도록 선언합니다.
            이렇게 추상화해 두면 2장에서 햅틱을 추가하더라도 호출부 코드를 수정할 필요가 없습니다.

            눈금 회전, 목표 깊이 도달, 잠금 해제 이벤트가 각자의 전용 `cue`를 선택하면서도 동일한 라우팅 파이프라인을 거쳐 출력되는지 확인하세요.

            @Image(
                source: "tutorial-section-audio-routing.png",
                alt: "눈금 회전, 목표 깊이 도달, 잠금 해제 이벤트가 각각의 큐를 선택해 사운드와 햅틱 파형을 함께 재생하는 라우팅 흐름"
            )
        }

        @Steps {
            @Step {
                `cue`를 식별자로 받아 재생을 트리거하는 래퍼 메서드를 선언하고, 캐시 딕셔너리에 준비된 플레이어가 있는지 확인합니다.
                다음 단계에서 이 메서드 내부에 세기 파라미터 제어와 재생 명령을 작성합니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-01-PlayCueShell.swift",
                    previousFile: "01-03-00-Playback-Scaffold.swift"
                )
            }

            @Step {
                오디오 볼륨과 햅틱 강도가 재생 시작 즉시(`relativeTime: 0`) 적용될 수 있도록 동적 파라미터(`CHHapticDynamicParameter`)로 구성합니다.
                두 값은 같은 플레이어로 전달되므로 동일한 시간 기준점을 씁니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-02-DynamicParameters.swift",
                    previousFile: "01-03-01-PlayCueShell.swift"
                )
            }

            @Step {
                동적 파라미터를 플레이어에 전송(`sendParameters`)한 직후 플레이어를 시작(`start`)합니다.
                이 호출로 AHAP 내부의 오디오와 향후 추가될 햅틱 진동이 같은 시간 기준으로 함께 시작됩니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-03-StartCue.swift",
                    previousFile: "01-03-02-DynamicParameters.swift"
                )
            }

            @Step {
                다이얼 눈금 통과와 잠금 확정 인터랙션에 `click` 큐를 매핑합니다.
                프로젝트에 내장된 틱 교차 규칙(Alternating Rule) 덕분에 동일한 짧은 소리가 기계적으로 겹치지 않고 자연스럽게 번갈아 나옵니다. 다이얼 구현부는 세부 파일 이름을 몰라도 필요한 세기만 전달하면 됩니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-04-RouteClick.swift",
                    previousFile: "01-03-03-StartCue.swift"
                )
            }

            @Step {
                목표 깊이에 도달했을 때는 도착 소리(`depthArrivalClick`)를, 정답 번호에 맞아 자물쇠가 풀릴 때는 해제 소리를 각각 라우팅합니다.
                서로 다른 소리를 연결하여 새로운 미해결 위치에 도착한 것과 잠금 해제 순간을 분명히 구분할 수 있게 합니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-05-RouteDepthArrival.swift",
                    previousFile: "01-03-04-RouteClick.swift"
                )
            }

            @Step {
                지원되는 실제 iPhone 기기에 앱을 빌드하고 첫 번째 자물쇠 다이얼을 테스트합니다.
                다이얼을 돌릴 때 두 가지 틱 사운드가 매끄럽게 교차하고, 깊이 도달 소리와 잠금 해제 피드백이 또렷하게 구분되어 재생되는지 확인합니다.

                @Image(
                    source: "step-preview-sound.png",
                    alt: "첫 번째 자물쇠가 활성화되어 다이얼 사운드를 실제 기기에서 테스트하는 앱 화면"
                )
            }
        }
    }
}
