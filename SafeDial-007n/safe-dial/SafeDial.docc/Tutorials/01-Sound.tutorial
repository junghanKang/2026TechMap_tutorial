@Tutorial(time: 25) {
    @Intro(title: "소리 재생 준비하기") {
        @Image(
            source: "tutorial-chapter-sound.png",
            alt: "첫 번째 자물쇠 다이얼과 눈금, 잠금, 열림을 나타내는 세 가지 소리 파형"
        )

        눈금 하나를 지날 때, 새 위치를 찾았을 때, 자물쇠가 열릴 때 서로 다른 소리가 납니다.
        이 장에서는 그 소리를 미리 준비해 필요할 때 바로 재생합니다.

        이 장을 마치면 완성 프로젝트에 정의된 소리 신호를 미리 준비하고, 알맞은 순간에 바로 재생할 수 있습니다.

        먼저 완성 프로젝트를 실행해 세 소리를 들어 보세요. 처음 보는 API라면 Apple의
        [Core Haptics 개요](https://developer.apple.com/documentation/corehaptics)와
        [AVAudioSession](https://developer.apple.com/documentation/avfaudio/avaudiosession)를 먼저 읽어도 좋습니다.
        소리 신호의 이름과 눈금 교대 규칙은 완성 프로젝트에 이미 정의되어 있습니다. 여기서는 그 목록을
        엔진에 준비하고 게임의 사건에 연결하는 흐름부터 시작합니다.
    }

    @Section(title: "재생 준비를 한 번에 끝내기") {
        @ContentAndMedia {
            다이얼을 돌릴 때마다 파일을 읽고 재생기를 새로 만들면 반응이 늦어집니다. 앱을 시작할 때
            오디오 출력 설정, AHAP 파일, 재생기를 한 번에 준비해 둡니다.

            `CHHapticEngine(audioSession:)`은 다음 장에서 소리와 햅틱을 같은 시간에 시작하게 해 줍니다.
        }

        @Steps {
            @Step {
                앱의 소리 설정을 만들고, 다른 앱의 음악과 함께 들리도록 정합니다. 엔진을 만들기 전에
                이 설정을 켜서 소리가 나갈 준비를 끝냅니다.

                @Code(
                    name: "AudioHapticsPlayer.swift",
                    file: "01-02-01-AudioSession.swift",
                    previousFile: "01-02-00-Preparation-Scaffold.swift"
                )
            }

            @Step {
                모든 `cue`에 해당하는 AHAP 파일을 찾아 패턴으로 읽습니다. 하나라도 실패하면 반쯤 만든
                목록을 쓰지 않고 실패를 알립니다.

                @Code(
                    name: "AudioHapticsPlayer.swift",
                    file: "01-02-02-LoadPatterns.swift",
                    previousFile: "01-02-01-AudioSession.swift"
                )
            }

            @Step {
                확인한 패턴과 오디오 설정으로 엔진을 만들고 시작합니다. 이 단계에서는 엔진만 만들고,
                소리별 재생기는 다음 단계에서 준비합니다.

                @Code(
                    name: "AudioHapticsPlayer.swift",
                    file: "01-02-03-StartEngine.swift",
                    previousFile: "01-02-02-LoadPatterns.swift"
                )
            }

            @Step {
                엔진으로 각 패턴의 재생기를 만들고 `cue` 이름으로 저장합니다. 눈금을 지날 때는 재생기를
                새로 만들지 않고, 저장해 둔 것을 바로 씁니다.

                @Code(
                    name: "AudioHapticsPlayer.swift",
                    file: "01-02-04-PreparePlayers.swift",
                    previousFile: "01-02-03-StartEngine.swift"
                )
            }
        }
    }

    @Section(title: "소리 재생 경로 만들기") {
        @ContentAndMedia {
            재생기를 고른 뒤 소리 크기와 햅틱 세기를 같은 시각에 전달합니다. 아직 햅틱 패턴을 만들지
            않았어도, 재생 메서드는 두 값을 함께 받게 합니다. 다음 장에서 햅틱을 더해도 게임 쪽 호출은
            바뀌지 않습니다.
        }

        @Steps {
            @Step {
                `cue`를 재생하는 메서드를 만들고, 준비된 재생기가 있는지 확인합니다. 다음 단계에서 이
                메서드에 세기와 시작 명령을 넣습니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-01-PlayCueShell.swift",
                    previousFile: "01-03-00-Playback-Scaffold.swift"
                )
            }

            @Step {
                소리 크기와 햅틱 세기를 재생 시작 시각 0의 값으로 만듭니다. 두 값이 같은 재생기에
                들어가므로 같은 시간 기준을 씁니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-02-DynamicParameters.swift",
                    previousFile: "01-03-01-PlayCueShell.swift"
                )
            }

            @Step {
                세기 값을 보낸 뒤 재생기를 바로 시작합니다. 이 한 명령으로 AHAP 안의 소리와, 다음 장에서
                추가할 햅틱이 함께 시작됩니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-03-StartCue.swift",
                    previousFile: "01-03-02-DynamicParameters.swift"
                )
            }

            @Step {
                다이얼 눈금과 잠금 확정 순간에 click `cue`를 연결합니다. 두 경우 모두 완성 프로젝트의 교대
                규칙을 쓰므로 같은 짧은 소리가 연달아 반복되지 않습니다. 다이얼 코드는 파일 이름을 몰라도
                필요한 세기만 전달하면 됩니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-04-RouteClick.swift",
                    previousFile: "01-03-03-StartCue.swift"
                )
            }

            @Step {
                자물쇠가 열릴 때는 해제 소리를, 새 위치를 찾을 때는 도착 소리를 연결합니다. 서로 다른
                소리를 써서 화면을 보지 않아도 두 상황을 구분할 수 있게 합니다.

                @Code(
                    name: "AudioHapticsPlayback.swift",
                    file: "01-03-05-RouteDepthArrival.swift",
                    previousFile: "01-03-04-RouteClick.swift"
                )
            }

            @Step {
                실기기에서 첫 번째 자물쇠를 돌려 봅니다. 두 눈금 소리가 번갈아 나고, 깊이 도착 소리와
                잠금 해제 소리가 각각 분명히 구분되는지 확인합니다.

                @Image(
                    source: "step-preview-sound.png",
                    alt: "첫 번째 자물쇠가 활성화되어 다이얼 소리를 시험하는 앱 화면"
                )
            }
        }
    }
}
